def latest_compatible_predecessor(
    conn,
    group_id,
    artifact_id,
    current_version,
    policy_sha256,
    exclude_jar_sha256=None,
):
    query = """
        SELECT *
        FROM scans
        WHERE group_id = %s
          AND artifact_id = %s
          AND version IS DISTINCT FROM %s
          AND config_key = %s
          AND policy_sha256 = %s
          AND method_hash_schema = %s
          AND pa_archive_schema = %s
          AND status = 'done'
          AND result_path IS NOT NULL
    """

    params = [
        group_id,
        artifact_id,
        current_version,
        config.CONFIG_KEY,
        policy_sha256,
        config.METHOD_HASH_SCHEMA,
        config.PA_ARCHIVE_SCHEMA,
    ]

    if exclude_jar_sha256:
        query += " AND jar_sha256 <> %s"
        params.append(exclude_jar_sha256)

    query += """
        ORDER BY finished_at DESC
        LIMIT 1
    """

    with conn.cursor() as cur:
        cur.execute(query, params)
        return cur.fetchone()
        
