@app.post(
    "/scans",
    dependencies=[Depends(require_api_key)],
)
async def submit_scan(
    jar: UploadFile = File(...),
    pom: UploadFile | None = File(default=None),
    policy: UploadFile | None = File(default=None),
    previous_scan_id: str | None = Form(default=None),
    force: bool = False,
):
    if force and previous_scan_id:
        raise HTTPException(
            status_code=400,
            detail=(
                "force=true cannot be combined with "
                "previous_scan_id"
            ),
        )

    jar_bytes = await jar.read()

    if len(jar_bytes) > config.MAX_UPLOAD_MB * 1024 * 1024:
        raise HTTPException(
            status_code=413,
            detail=(
                f"jar larger than "
                f"{config.MAX_UPLOAD_MB} MB"
            ),
        )

    if jar_bytes[:4] != b"PK\x03\x04":
        raise HTTPException(
            status_code=400,
            detail=(
                "the jar field does not contain "
                "a jar/zip file"
            ),
        )

    jar_sha256 = hashlib.sha256(jar_bytes).hexdigest()
    pom_bytes = await pom.read() if pom is not None else None
    policy_bytes = (
        await policy.read()
        if policy is not None
        else None
    )

    policy_sha256 = (
        hashlib.sha256(policy_bytes).hexdigest()
        if policy_bytes
        else ""
    )

    if pom_bytes:
        gav = gav_from_pom(pom_bytes)
    else:
        stem = (
            jar.filename or "upload.jar"
        ).rsplit("/", 1)[-1].removesuffix(".jar")

        gav = (
            "public.upload",
            stem,
            jar_sha256[:12],
        )

    group_id, artifact_id, version = gav
    parsed_previous_scan_id = parse_optional_uuid(
        previous_scan_id,
        "previous_scan_id",
    )

    scan_id = uuid.uuid4()

    with db.connect() as conn:
        if not force and parsed_previous_scan_id is None:
            exact = db.exact_result_lookup(
                conn,
                group_id,
                artifact_id,
                version,
                jar_sha256,
                policy_sha256,
            )

            if exact:
                row = db.create_exact_result_scan(
                    conn,
                    scan_id,
                    "api",
                    gav,
                    jar_sha256,
                    policy_sha256,
                    exact,
                )

                conn.commit()

                return JSONResponse(
                    status_code=200,
                    content=scan_json(row),
                )

        predecessor = None

        if not force:
            if parsed_previous_scan_id is not None:
                predecessor = (
                    db.validate_explicit_predecessor(
                        conn,
                        parsed_previous_scan_id,
                        group_id,
                        artifact_id,
                        policy_sha256,
                    )
                )

                if predecessor is None:
                    raise HTTPException(
                        status_code=409,
                        detail=(
                            "the requested previous scan is "
                            "missing, unfinished, belongs to a "
                            "different GA, or is incompatible "
                            "with the current analysis configuration"
                        ),
                    )
            elif pom_bytes:
                predecessor = (
                    db.latest_compatible_predecessor(
                        conn,
                        group_id,
                        artifact_id,
                        version,
                        policy_sha256,
                        exclude_jar_sha256=jar_sha256,
                    )
                )

        reuse_mode = (
            "previous-analysis"
            if predecessor
            else "full-analysis"
        )

        nexus.raw_upload(
            config.UPLOADS_REPO,
            f"{scan_id}/input.jar",
            jar_bytes,
        )

        if pom_bytes:
            nexus.raw_upload(
                config.UPLOADS_REPO,
                f"{scan_id}/pom.xml",
                pom_bytes,
                content_type="application/xml",
            )

        if policy_bytes:
            nexus.raw_upload(
                config.UPLOADS_REPO,
                f"{scan_id}/policy.xml",
                policy_bytes,
                content_type="application/xml",
            )

        row = db.create_scan(
            conn,
            scan_id,
            "api",
            gav,
            jar_sha256,
            policy_sha256,
            reuse=predecessor,
            reuse_mode=reuse_mode,
        )

        conn.commit()

    return JSONResponse(
        status_code=202,
        content=scan_json(row),
    )


@app.get("/scans", dependencies=[Depends(require_api_key)])
def list_scans(limit: int = 20, status: str | None = None):
    with db.connect() as conn:
        rows = db.list_scans(conn, limit=limit, status=status)
    return {"scans": [scan_json(r) for r in rows]}


@app.get("/scans/{scan_id}", dependencies=[Depends(require_api_key)])
def get_scan(scan_id: uuid.UUID):
    with db.connect() as conn:
        row = db.get_scan(conn, scan_id)
    if row is None:
        raise HTTPException(status_code=404, detail="unknown scan id")
    return scan_json(row)


def stream_zip(result_path, filename):
    resp = nexus.raw_stream(config.REPORTS_REPO, result_path)
    if resp is None:
        raise HTTPException(status_code=404, detail="result zip is missing from storage")
    return StreamingResponse(
        resp.iter_content(chunk_size=65536),
        media_type="application/zip",
        headers={"Content-Disposition": f'attachment; filename="{filename}"'},
    )


@app.get("/scans/{scan_id}/summary", dependencies=[Depends(require_api_key)])
def get_summary(scan_id: uuid.UUID):
    with db.connect() as conn:
        row = db.get_scan(conn, scan_id)
    if row is None:
        raise HTTPException(status_code=404, detail="unknown scan id")
    if row["status"] != "done" or not row["result_path"]:
        raise HTTPException(status_code=409, detail=f"scan is {row['status']}, not done")
    return stream_zip(row["result_path"], f"symmaries-{scan_id}.zip")


@app.get("/reports/{group_id}/{artifact_id}/{version}", dependencies=[Depends(require_api_key)])
def get_report(group_id: str, artifact_id: str, version: str):
    with db.connect() as conn:
        row = db.latest_done_for_gav(conn, group_id, artifact_id, version)
    if row is None:
        raise HTTPException(status_code=404, detail="no finished scan for these coordinates")
    return stream_zip(row["result_path"], f"{artifact_id}-{version}-symmaries.zip")


def parse_optional_uuid(
    value: str | None,
    field_name: str,
) -> uuid.UUID | None:
    if value is None or not value.strip():
        return None

    try:
        return uuid.UUID(value.strip())
    except ValueError:
        raise HTTPException(
            status_code=400,
            detail=f"{field_name} is not a valid UUID",
        )


def gav_from_pom(pom_bytes):
    try:
        root = ET.fromstring(pom_bytes)
    except ET.ParseError:
        raise HTTPException(
            status_code=400,
            detail="pom is not well-formed XML",
        )

    namespace = (
        root.tag.split("}")[0] + "}"
        if root.tag.startswith("{")
        else ""
    )

    def find(parent, tag):
        element = parent.find(f"{namespace}{tag}")
        if element is None or not element.text:
            return None
        return element.text.strip()

    parent = root.find(f"{namespace}parent")

    group_id = (
        find(root, "groupId")
        or (
            find(parent, "groupId")
            if parent is not None
            else None
        )
    )

    artifact_id = find(root, "artifactId")

    version = (
        find(root, "version")
        or (
            find(parent, "version")
            if parent is not None
            else None
        )
    )

    if not group_id or not artifact_id or not version:
        raise HTTPException(
            status_code=400,
            detail=(
                "pom does not provide a complete "
                "groupId, artifactId and version"
            ),
        )

    unresolved = [
        value
        for value in (group_id, artifact_id, version)
        if "${" in value
    ]

    if unresolved:
        raise HTTPException(
            status_code=400,
            detail=(
                "pom coordinates contain unresolved properties; "
                "submit resolved coordinates"
            ),
        )

    return group_id, artifact_id, version

