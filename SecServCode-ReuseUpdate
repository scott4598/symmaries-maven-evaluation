"""Watches the staging repository and queues scan jobs.

Runs as a background thread inside the API service. Every POLL_INTERVAL_SECONDS
it lists the staging repository through the Nexus components API (the listing
includes each asset's SHA-256, so nothing is downloaded here), records
components it has not seen before, checks the dedup ledger and inserts a scan
job. It also requeues running jobs whose worker died.
"""

import logging
import threading
import time
import uuid

from . import config, db, nexus

log = logging.getLogger("poller")


def poll_once():
    with db.connect() as conn:
        requeued = db.requeue_stale_running(conn, config.STALE_RUNNING_MINUTES)
        if requeued:
            log.warning("requeued %d stale running scan(s)", requeued)

        for component in nexus.list_components(config.STAGING_REPO):
            asset = nexus.jar_asset(component)
            if asset is None:
                continue
            group = component.get("group") or ""
            artifact = component.get("name") or ""
            version = component.get("version") or ""
            sha256 = (asset.get("checksum") or {}).get("sha256")
            if not sha256:
                continue
            
            policy_sha256 = nexus.policy_sha256(component)

            new = db.nexus_mark_seen(
                conn,
                config.STAGING_REPO,
                group,
                artifact,
                version,
                sha256,
                policy_sha256,
            )

            if not new:
                continue

            exact = db.exact_result_lookup(
                conn,
                group,
                artifact,
                version,
                sha256,
                policy_sha256,
            )

            scan_id = uuid.uuid4()

            if exact:
                scan = db.create_exact_result_scan(
                    conn,
                    scan_id,
                    "nexus",
                    (group, artifact, version),
                    sha256,
                    policy_sha256,
                    exact,
                )

                conn.commit()

                log.info(
                    "recorded exact-result scan %s for %s:%s:%s "
                    "using result from %s",
                    scan["id"],
                    group,
                    artifact,
                    version,
                    exact["id"],
                )

                continue

            existing_gav = db.latest_done_for_gav(
                conn,
                group,
                artifact,
                version,
            )

            if (
                existing_gav
                and existing_gav["jar_sha256"] != sha256
                and not version.endswith("-SNAPSHOT")
            ):
                log.error(
                    "immutable GAV collision for %s:%s:%s: "
                    "previous sha=%s, submitted sha=%s",
                    group,
                    artifact,
                    version,
                    existing_gav["jar_sha256"][:12],
                    sha256[:12],
                )

                scan = db.create_scan(
                    conn,
                    scan_id,
                    "nexus",
                    (group, artifact, version),
                    sha256,
                    policy_sha256,
                    reuse=None,
                    reuse_mode="full-analysis",
                )

                with conn.cursor() as cur:
                    cur.execute(
                        """
                        UPDATE scans
                        SET status = 'failed',
                            error = %s,
                            finished_at = now()
                        WHERE id = %s
                        """,
                        (
                            "non-SNAPSHOT GAV was redeployed "
                            "with different JAR bytes",
                            scan["id"],
                        ),
                    )

                conn.commit()
                continue

            predecessor = db.latest_compatible_predecessor(
                conn,
                group,
                artifact,
                version,
                policy_sha256,
                exclude_jar_sha256=sha256,
            )

            reuse_mode = (
                "previous-analysis"
                if predecessor
                else "full-analysis"
            )

            scan = db.create_scan(
                conn,
                scan_id,
                "nexus",
                (group, artifact, version),
                sha256,
                policy_sha256,
                reuse=predecessor,
                reuse_mode=reuse_mode,
            )

            conn.commit()

            log.info(
                "queued %s scan %s for %s:%s:%s "
                "(sha %s, predecessor %s)",
                reuse_mode,
                scan["id"],
                group,
                artifact,
                version,
                sha256[:12],
                (
                    predecessor["id"]
                    if predecessor
                    else "none"
                ),
            )


def run_forever():
    while True:
        try:
            poll_once()
        except Exception:
            log.exception("poll cycle failed; retrying next interval")
        time.sleep(config.POLL_INTERVAL_SECONDS)


def start():
    t = threading.Thread(target=run_forever, name="nexus-poller", daemon=True)
    t.start()
    return t

