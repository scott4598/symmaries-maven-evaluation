def nexus_mark_seen(conn, repo, group_id, artifact_id, version, sha256, policy_sha256=""):
    """Returns True if this component was newly recorded (i.e. not seen before).
    The primary key (including the policy hash) makes this safe with concurrent
    pollers and re-triggers when the policy changes for the same jar."""
    with conn.cursor() as cur:
        cur.execute(
            """INSERT INTO nexus_seen
                 (repository, group_id, artifact_id, version, sha256, policy_sha256)
               VALUES (%s, %s, %s, %s, %s, %s)
               ON CONFLICT DO NOTHING""",
            (repo, group_id, artifact_id, version, sha256, policy_sha256),
        )
        return cur.rowcount == 1


