    with conn.cursor() as cur:
        cur.execute(
            """UPDATE scans SET status = 'queued', started_at = NULL
               WHERE status = 'running' AND started_at < now() - %s * interval '1 minute'""",
            (minutes,),
        )
        return cur.rowcount

