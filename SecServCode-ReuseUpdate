    @Override
    public void execute() throws MojoExecutionException {
        if (skip) {
            getLog().info("Symmaries analysis skipped.");
            return;
        }

        try {
            executePipeline();
        } catch (MojoExecutionException exception) {
            if (failOnError) {
                throw exception;
            }

            getLog().warn(
                    "Symmaries analysis failed in advisory mode: "
                            + exception.getMessage()
            );

            if (getLog().isDebugEnabled()) {
                getLog().debug(exception);
            }
        }
    }

    private void executePipeline() throws MojoExecutionException {
        validateConfiguration();

        File artifactFile = resolveJarArtifact();

        if (artifactFile == null) {
            return;
        }

        File pomFile = project.getFile();
        //File policyFile = findPolicyFile(project.getBasedir());
        File resolvedPolicyFile = resolvePolicyFile();

        ensureOutputDirectory();

        RequestConfig requestConfig = RequestConfig.custom()
                .setConnectTimeout(connectTimeoutSeconds * 1000)
                .setConnectionRequestTimeout(connectTimeoutSeconds * 1000)
                .setSocketTimeout(requestTimeoutSeconds * 1000)
                .build();

        try (
                CloseableHttpClient httpClient = HttpClients.custom()
                        .setDefaultRequestConfig(requestConfig)
                        .build()
        ) {
            Submission submission = submitScan(
                    httpClient,
                    artifactFile,
                    pomFile,
                    //policyFile
                    resolvedPolicyFile
            );

            writeScanMetadata(
                    submission,
                    artifactFile,
                    //policyFile,
                    resolvedPolicyFile,
                    submission.initialStatus,
                    null
            );

            if (submitOnly) {
                getLog().info(
                        "Symmaries scan submitted in submit-only mode. "
                                + "Scan ID: "
                                + submission.scanId
                );
                return;
            }

            JsonObject completedScan = waitForCompletion(
                    httpClient,
                    submission
            );

            String completedStatus = getOptionalString(
                    completedScan,
                    "status"
            );

            writeScanMetadata(
                    submission,
                    artifactFile,
                    //policyFile,
                    resolvedPolicyFile,
                    completedStatus,
                    completedScan
            );

            downloadSummary(
                    httpClient,
                    submission.scanId
            );
        } catch (IOException exception) {
            throw new MojoExecutionException(
                    "Symmaries API communication failed",
                    exception
            );
        }
    }

    private void validateConfiguration()
            throws MojoExecutionException {

        if (apiUrl == null || apiUrl.trim().isEmpty()) {
            throw new MojoExecutionException(
                    "symmaries.apiUrl is required"
            );
        }

        apiUrl = stripTrailingSlash(apiUrl.trim());

        String environmentApiKey =
                System.getenv("SYMMARIES_API_KEY");

        if (
                (apiKey == null || apiKey.trim().isEmpty())
                        && environmentApiKey != null
                        && !environmentApiKey.trim().isEmpty()
        ) {
            apiKey = environmentApiKey.trim();
        }

        if (apiKey == null || apiKey.trim().isEmpty()) {
            throw new MojoExecutionException(
                    "No Symmaries API key supplied. Set the "
                            + "SYMMARIES_API_KEY environment variable or "
                            + "-Dsymmaries.apiKey."
            );
        }

        if (timeoutSeconds <= 0) {
            throw new MojoExecutionException(
                    "symmaries.timeoutSeconds must be greater than zero"
            );
        }

        if (pollIntervalSeconds <= 0) {
            throw new MojoExecutionException(
                    "symmaries.pollIntervalSeconds must be greater than zero"
            );
        }
		
		if (force && previousScanId != null && !previousScanId.trim().isEmpty()) {
			throw new MojoExecutionException(
					"symmaries.force cannot be combined with "
							+ "symmaries.previousScanId"
			);
		}
    }

    private File resolveJarArtifact()
            throws MojoExecutionException {

        String packaging = project.getPackaging();

        if ("pom".equalsIgnoreCase(packaging)) {
            getLog().info(
                    "Skipping POM/aggregator project: "
                            + project.getId()
            );
            return null;
        }

        File artifactFile = null;

        if (project.getArtifact() != null) {
            artifactFile = project.getArtifact().getFile();
        }

        if (
                artifactFile == null
                        || !artifactFile.isFile()
        ) {
            String message =
                    "Main Maven artifact is unavailable for "
                            + project.getId();

            if (skipUnsupportedPackaging) {
                getLog().warn(message + "; skipping module.");
                return null;
            }

            throw new MojoExecutionException(message);
        }

        if (
                !artifactFile.getName()
                        .toLowerCase(Locale.ROOT)
                        .endsWith(".jar")
        ) {
            String message =
                    "The Symmaries API currently accepts JAR files only. "
                            + "Resolved artifact was: "
                            + artifactFile.getAbsolutePath();

            if (skipUnsupportedPackaging) {
                getLog().info(message + "; skipping module.");
                return null;
            }

            throw new MojoExecutionException(message);
        }

        long maximumBytes = 100L * 1024L * 1024L;

        if (artifactFile.length() > maximumBytes) {
            throw new MojoExecutionException(
                    "Artifact exceeds the current 100 MB API upload "
                            + "limit: "
                            + artifactFile.getAbsolutePath()
                            + " ("
                            + artifactFile.length()
                            + " bytes)"
            );
        }

        return artifactFile;
    }

    private Submission submitScan(
            CloseableHttpClient httpClient,
            File artifactFile,
            File pomFile,
            File policyFile
    ) throws IOException, MojoExecutionException {

        String submitUrl =
                apiUrl
                        + "/scans"
                        + (force ? "?force=true" : "");

        getLog().info(
                "Submitting artifact to Symmaries: "
                        + artifactFile.getAbsolutePath()
        );

        getLog().info(
                "Symmaries API URL: "
                        + submitUrl
        );

        HttpPost request = new HttpPost(submitUrl);
        request.addHeader("X-Api-Key", apiKey);

        MultipartEntityBuilder multipart =
                MultipartEntityBuilder.create();

        multipart.addPart(
                "jar",
                new FileBody(
                        artifactFile,
                        ContentType.APPLICATION_OCTET_STREAM
                )
        );

        if (pomFile != null && pomFile.isFile()) {
            multipart.addPart(
                    "pom",
                    new FileBody(
                            pomFile,
                            ContentType.APPLICATION_XML
                    )
            );
        } else {
            getLog().warn(
                    "Project POM is unavailable. Dependency resolution "
                            + "during analysis may be less precise."
            );
        }

        if (policyFile != null && policyFile.isFile()) {
            getLog().info(
                    "Attaching application policy: "
                            + policyFile.getAbsolutePath()
            );

            multipart.addPart(
                    "policy",
                    new FileBody(
                            policyFile,
                            ContentType.APPLICATION_OCTET_STREAM
                    )
            );
        } else {
            getLog().warn(
                    "No application policy found at "
                            + "src/main/symproto/sources-and-sinks.xml"
            );
        }
		
		if (
				previousScanId != null
						&& !previousScanId.trim().isEmpty()
		) {
			multipart.addTextBody(
					"previous_scan_id",
					previousScanId.trim(),
					ContentType.TEXT_PLAIN
			);
		}

        request.setEntity(multipart.build());

        try (
                CloseableHttpResponse response =
                        httpClient.execute(request)
        ) {
            int code =
                    response.getStatusLine().getStatusCode();

            String responseBody =
                    response.getEntity() == null
                            ? ""
                            : EntityUtils.toString(
                            response.getEntity(),
                            StandardCharsets.UTF_8
                    );

            if (code != 200 && code != 202) {
                throw new MojoExecutionException(
                        "Symmaries submission failed with HTTP "
                                + code
                                + ". Response: "
                                + responseBody
                );
            }

            JsonObject json =
                    parseJsonObject(
                            responseBody,
                            "submission response"
                    );

            String scanId =
                    getRequiredString(json, "id");

            String status =
                    getRequiredString(json, "status");

            boolean deduplicated =
                    getOptionalBoolean(
                            json,
                            "deduplicated",
                            code == 200
                    );

            String jarSha256 =
                    getOptionalString(
                            json,
                            "jar_sha256"
                    );

            String createdAt =
                    getOptionalString(
                            json,
                            "created_at"
                    );
					
			String reuseMode = getOptionalString(
							json,
							"reuse_mode"
					);

					String reuseOf = getOptionalString(
							json,
							"reuse_of"
					);

					String message = getOptionalString(
							json,
							"message"
					);

            getLog().info(
					"Symmaries scan accepted. Scan ID: "
							+ scanId
							+ ", status: "
							+ status
							+ ", reuse mode: "
							+ reuseMode
							+ ", predecessor: "
							+ (reuseOf == null ? "none" : reuseOf)
			);

			if (message != null && !message.trim().isEmpty()) {
				getLog().info(message);
			}

            return new Submission(
					scanId,
					status,
					deduplicated,
					jarSha256,
					createdAt,
					code,
					reuseMode,
					reuseOf,
					message
			);
        }
    }

    private JsonObject waitForCompletion(
            CloseableHttpClient httpClient,
            Submission submission
    ) throws IOException, MojoExecutionException {

        String currentStatus =
                submission.initialStatus;

        if ("done".equalsIgnoreCase(currentStatus)) {
			JsonObject alreadyDone = new JsonObject();

			alreadyDone.add("id", submission.scanId);
			alreadyDone.add("status", "done");
			alreadyDone.add(
					"deduplicated",
					submission.deduplicated
			);
			alreadyDone.add(
					"reuse_mode",
					submission.reuseMode == null
							? ""
							: submission.reuseMode
			);
			alreadyDone.add(
					"reuse_of",
					submission.reuseOf == null
							? ""
							: submission.reuseOf
			);
			alreadyDone.add(
					"message",
					submission.message == null
							? ""
							: submission.message
			);

			return alreadyDone;
		}

        long deadline =
                System.currentTimeMillis()
                        + timeoutSeconds * 1000L;

        while (true) {
            if (
                    "failed".equalsIgnoreCase(currentStatus)
                            || "error".equalsIgnoreCase(currentStatus)
            ) {
                throw new MojoExecutionException(
                        "Symmaries backend reported scan failure for "
                                + submission.scanId
                );
            }

            if (System.currentTimeMillis() > deadline) {
                throw new MojoExecutionException(
                        "Timed out after "
                                + timeoutSeconds
                                + " seconds waiting for Symmaries scan "
                                + submission.scanId
                );
            }

            sleepBeforePoll(currentStatus);

            HttpGet request = new HttpGet(
                    apiUrl
                            + "/scans/"
                            + submission.scanId
            );

            request.addHeader("X-Api-Key", apiKey);

            try (
                    CloseableHttpResponse response =
                            httpClient.execute(request)
            ) {
                int code =
                        response.getStatusLine().getStatusCode();

                String responseBody =
                        response.getEntity() == null
                                ? ""
                                : EntityUtils.toString(
                                response.getEntity(),
                                StandardCharsets.UTF_8
                        );

                if (code != 200) {
                    throw new MojoExecutionException(
                            "Symmaries status request failed with HTTP "
                                    + code
                                    + ". Response: "
                                    + responseBody
                    );
                }

                JsonObject json =
                        parseJsonObject(
                                responseBody,
                                "status response"
                        );

                currentStatus =
                        getRequiredString(
                                json,
                                "status"
                        );

                String backendError =
                        getOptionalString(
                                json,
                                "error"
                        );

                if (
                        backendError != null
                                && !backendError.trim().isEmpty()
                ) {
                    throw new MojoExecutionException(
                            "Symmaries backend error: "
                                    + backendError
                    );
                }

                if ("done".equalsIgnoreCase(currentStatus)) {
                    getLog().info(
                            "Symmaries scan completed: "
                                    + submission.scanId
                    );
                    return json;
                }

                if ("failed".equalsIgnoreCase(currentStatus)) {
                    throw new MojoExecutionException(
                            "Symmaries scan failed: "
                                    + submission.scanId
                    );
                }
            }
        }
    }

    private void sleepBeforePoll(
            String currentStatus
    ) throws MojoExecutionException {

        getLog().info(
                "Symmaries scan status is ["
                        + currentStatus
                        + "]. Waiting "
                        + pollIntervalSeconds
                        + " seconds."
        );

        try {
            Thread.sleep(
                    pollIntervalSeconds * 1000L
            );
        } catch (InterruptedException exception) {
            Thread.currentThread().interrupt();

            throw new MojoExecutionException(
                    "Symmaries polling was interrupted",
                    exception
            );
        }
    }

    private void downloadSummary(
            CloseableHttpClient httpClient,
            String scanId
    ) throws IOException, MojoExecutionException {

        HttpGet request = new HttpGet(
                apiUrl
                        + "/scans/"
                        + scanId
                        + "/summary"
        );

        request.addHeader("X-Api-Key", apiKey);

        File outputFile = new File(
                outputDirectory,
                project.getArtifactId()
                        + "-"
                        + project.getVersion()
                        + "-"
                        + scanId
                        + "-symmaries.zip"
        );

        try (
                CloseableHttpResponse response =
                        httpClient.execute(request)
        ) {
            int code =
                    response.getStatusLine().getStatusCode();

            if (code != 200) {
                String responseBody =
                        response.getEntity() == null
                                ? ""
                                : EntityUtils.toString(
                                response.getEntity(),
                                StandardCharsets.UTF_8
                        );

                throw new MojoExecutionException(
                        "Symmaries summary download failed with HTTP "
                                + code
                                + ". Response: "
                                + responseBody
                );
            }

            try (
                    InputStream input =
                            response.getEntity().getContent();
                    FileOutputStream output =
                            new FileOutputStream(outputFile)
            ) {
                byte[] buffer = new byte[8192];
                int bytesRead;

                while (
                        (bytesRead = input.read(buffer)) != -1
                ) {
                    output.write(
                            buffer,
                            0,
                            bytesRead
                    );
                }
            }
        }

        getLog().info(
                "Symmaries summary saved to: "
                        + outputFile.getAbsolutePath()
        );
    }

    private void writeScanMetadata(
            Submission submission,
            File artifactFile,
            File policyFile,
            String currentStatus,
            JsonObject statusResponse
    ) throws MojoExecutionException {

        JsonObject metadata = new JsonObject();

		String finalReuseMode = submission.reuseMode;
		String finalReuseOf = submission.reuseOf;

		if (statusResponse != null) {
			String responseReuseMode = getOptionalString(
					statusResponse,
					"reuse_mode"
			);

			String responseReuseOf = getOptionalString(
					statusResponse,
					"reuse_of"
			);

			if (
					responseReuseMode != null
							&& !responseReuseMode.trim().isEmpty()
			) {
				finalReuseMode = responseReuseMode;
			}

			if (responseReuseOf != null) {
				finalReuseOf = responseReuseOf;
			}
		}
        metadata.add("scan_id", submission.scanId);
        metadata.add(
                "status",
                currentStatus == null
                        ? "unknown"
                        : currentStatus
        );

        metadata.add(
                "deduplicated",
                submission.deduplicated
        );

        metadata.add(
                "submission_http_status",
                submission.httpStatus
        );

        metadata.add(
                "group_id",
                project.getGroupId()
        );

        metadata.add(
                "artifact_id",
                project.getArtifactId()
        );

        metadata.add(
                "version",
                project.getVersion()
        );

        metadata.add(
                "packaging",
                project.getPackaging()
        );

        metadata.add(
                "artifact_path",
                artifactFile.getAbsolutePath()
        );

        metadata.add(
                "jar_sha256",
                submission.jarSha256 == null
                        ? ""
                        : submission.jarSha256
        );

        metadata.add(
                "policy_path",
                policyFile == null
                        ? ""
                        : policyFile.getAbsolutePath()
        );

        metadata.add(
                "force",
                force
        );

        metadata.add(
                "submit_only",
                submitOnly
        );

        metadata.add(
                "api_url",
                apiUrl
        );

        metadata.add(
                "client_recorded_at",
                Instant.now().toString()
        );

        metadata.add(
                "server_created_at",
                submission.createdAt == null
                        ? ""
                        : submission.createdAt
        );
		
		metadata.add(
				"reuse_mode",
				finalReuseMode == null
						? ""
						: finalReuseMode
		);

		metadata.add(
				"reuse_of",
				finalReuseOf == null
						? ""
						: finalReuseOf
		);

		metadata.add(
				"server_message",
				submission.message == null
						? ""
						: submission.message
		);

        if (statusResponse != null) {
            addOptionalField(
                    metadata,
                    statusResponse,
                    "started_at"
            );

            addOptionalField(
                    metadata,
                    statusResponse,
                    "finished_at"
            );

            addOptionalField(
                    metadata,
                    statusResponse,
                    "origin"
            );

            addOptionalField(
                    metadata,
                    statusResponse,
                    "error"
            );
        }

        File metadataFile = new File(
                outputDirectory,
                project.getArtifactId()
                        + "-"
                        + project.getVersion()
                        + "-"
                        + submission.scanId
                        + "-scan.json"
        );

        try {
            Files.write(
                    metadataFile.toPath(),
                    metadata.toString()
                            .getBytes(StandardCharsets.UTF_8)
            );
        } catch (IOException exception) {
            throw new MojoExecutionException(
                    "Unable to write Symmaries scan metadata: "
                            + metadataFile.getAbsolutePath(),
                    exception
            );
        }
    }

    private void ensureOutputDirectory()
            throws MojoExecutionException {

        if (outputDirectory.isDirectory()) {
            return;
        }

        if (!outputDirectory.mkdirs()) {
            throw new MojoExecutionException(
                    "Unable to create Symmaries output directory: "
                            + outputDirectory.getAbsolutePath()
            );
        }
    }

    private File findPolicyFile(
            File baseDirectory
    ) {
        File expected = new File(
                baseDirectory,
                "src"
                        + File.separator
                        + "main"
                        + File.separator
                        + "symproto"
                        + File.separator
                        + "sources-and-sinks.xml"
        );

        if (expected.isFile()) {
            return expected;
        }

        File[] rootCandidates =
                baseDirectory.listFiles(
                        (directory, name) -> {
                            String normalised =
                                    name.toLowerCase(Locale.ROOT);

                            return normalised.contains("sources")
                                    && normalised.contains("sinks")
                                    && normalised.endsWith(".xml");
                        }
                );

        if (
                rootCandidates != null
                        && rootCandidates.length > 0
        ) {
            return rootCandidates[0];
        }

        return null;
    }

    private File resolvePolicyFile()
            throws MojoExecutionException {

        if (policyFile != null) {
            File explicitPolicy;

            if (policyFile.isAbsolute()) {
                explicitPolicy = policyFile;
            } else {
                explicitPolicy = new File(
                        project.getBasedir(),
                        policyFile.getPath()
                );
            }

            if (!explicitPolicy.isFile()) {
                throw new MojoExecutionException(
                        "Configured Symmaries policy file "
                                + "does not exist: "
                                + explicitPolicy.getAbsolutePath()
                );
            }

            getLog().info(
                    "Using configured Symmaries policy: "
                            + explicitPolicy.getAbsolutePath()
            );

            return explicitPolicy;
        }

        return findPolicyFile(
                project.getBasedir()
        );
    }

    private JsonObject parseJsonObject(
            String body,
            String description
    ) throws MojoExecutionException {

        try {
            return Json.parse(body).asObject();
        } catch (RuntimeException exception) {
            throw new MojoExecutionException(
                    "Unable to parse Symmaries "
                            + description
                            + ": "
                            + body,
                    exception
            );
        }
    }

    private String getRequiredString(
            JsonObject json,
            String field
    ) throws MojoExecutionException {

        String value = getOptionalString(
                json,
                field
        );

        if (value == null || value.trim().isEmpty()) {
            throw new MojoExecutionException(
                    "Symmaries response is missing required field: "
                            + field
            );
        }

        return value;
    }

    private String getOptionalString(
            JsonObject json,
            String field
    ) {
        JsonValue value = json.get(field);

        if (value == null || value.isNull()) {
            return null;
        }

        try {
            return value.asString();
        } catch (RuntimeException exception) {
            return value.toString();
        }
    }

    private boolean getOptionalBoolean(
            JsonObject json,
            String field,
            boolean defaultValue
    ) {
        JsonValue value = json.get(field);

        if (value == null || value.isNull()) {
            return defaultValue;
        }

        try {
            return value.asBoolean();
        } catch (RuntimeException exception) {
            return defaultValue;
        }
    }

    private void addOptionalField(
            JsonObject destination,
            JsonObject source,
            String field
    ) {
        String value = getOptionalString(
                source,
                field
        );

        destination.add(
                field,
                value == null ? "" : value
        );
    }

    private String stripTrailingSlash(
            String value
    ) {
        while (
                value.endsWith("/")
                        && value.length() > 1
        ) {
            value = value.substring(
                    0,
                    value.length() - 1
            );
        }

        return value;
    }

