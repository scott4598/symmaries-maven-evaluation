def compute_policy_tree_sha256() -> str:
    hasher = hashlib.sha256()
    policy_dir = Path(POLICY_DIR)

    if not policy_dir.is_dir():
        hasher.update(b"no-policy-directory")
        return hasher.hexdigest()

    files = sorted(
        path
        for path in policy_dir.rglob("*")
        if path.is_file()
    )

    for path in files:
        relative_path = path.relative_to(policy_dir)
        hasher.update(str(relative_path).encode("utf-8"))
        hasher.update(b"\0")
        hasher.update(path.read_bytes())
        hasher.update(b"\0")

    return hasher.hexdigest()


def compute_analysis_config_key() -> str:
    identity = {
        "policy_tree_sha256": compute_policy_tree_sha256(),
        "jsymcompiler_identity": JSYMCOMPILER_IDENTITY,
        "syrs_identity": SYRS_IDENTITY,
        "jsym_extra_args": JSYM_EXTRA_ARGS,
        "syrs_tflags": SYRS_TFLAGS,
        "method_hash_schema": METHOD_HASH_SCHEMA,
        "pa_archive_schema": PA_ARCHIVE_SCHEMA,
        "worker_schema": WORKER_SCHEMA,
    }

    encoded = json.dumps(
        identity,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")

    return hashlib.sha256(encoded).hexdigest()


CONFIG_KEY = compute_analysis_config_key()


