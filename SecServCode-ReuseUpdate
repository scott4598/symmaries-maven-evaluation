import requests

from . import config

session = requests.Session()
session.auth = (config.NEXUS_USER, config.NEXUS_PASSWORD)


def status_ok() -> bool:
    try:
        r = session.get(f"{config.NEXUS_URL}/service/rest/v1/status", timeout=5)
        return r.status_code == 200
    except requests.RequestException:
        return False


def list_components(repository):
    """Yield all components of a repository, following pagination."""
    token = None
    while True:
        params = {"repository": repository}
        if token:
            params["continuationToken"] = token
        r = session.get(
            f"{config.NEXUS_URL}/service/rest/v1/components", params=params, timeout=30
        )
        r.raise_for_status()
        body = r.json()
        yield from body.get("items", [])
        token = body.get("continuationToken")
        if not token:
            return


def jar_asset(component):
    """The main jar asset of a maven component (skips sources/javadoc jars)."""
    for asset in component.get("assets", []):
        path = asset.get("path", "")
        if path.endswith(".jar") and not path.endswith(("-sources.jar", "-javadoc.jar")):
            return asset
    return None


def policy_sha256(component):
    """SHA-256 of the sources/sinks policy"""
    for asset in component.get("assets", []):
        if asset.get("path", "").endswith("-policy.xml"):
            return (asset.get("checksum") or {}).get("sha256") or ""
    return ""


def raw_upload(repository, path, data, content_type="application/octet-stream"):
    r = session.put(
        f"{config.NEXUS_URL}/repository/{repository}/{path}",
        data=data,
        headers={"Content-Type": content_type},
        timeout=120,
    )
    r.raise_for_status()


def raw_stream(repository, path):
    """Open a streaming download from a repository. Returns the response or
    None when the file does not exist."""
    r = session.get(
        f"{config.NEXUS_URL}/repository/{repository}/{path}", stream=True, timeout=60
    )
    if r.status_code == 404:
        return None
    r.raise_for_status()
    return r

