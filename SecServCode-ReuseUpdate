import hashlib
import logging
import uuid
import xml.etree.ElementTree as ET

from fastapi import Depends, FastAPI, File, Form, Header, HTTPException, UploadFile
from fastapi.responses import JSONResponse, StreamingResponse

from . import config, db, nexus, poller

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(name)s %(levelname)s %(message)s")
log = logging.getLogger("api")

app = FastAPI(title="SymProto scan service", version="0.1")


@app.on_event("startup")
def startup():
    db.init_schema()
    if config.POLLER_ENABLED:
        poller.start()
        log.info("Nexus poller enabled")
    else:
        log.info("Nexus poller disabled")
    log.info("started; config_key=%s", config.CONFIG_KEY[:12])


def require_api_key(x_api_key: str | None = Header(default=None)):
    if x_api_key not in config.API_KEYS:
        raise HTTPException(status_code=401, detail="missing or unknown API key")


def scan_json(row):
    messages = {
        "exact-result": (
            "This exact project version has already been analysed."
        ),
        "previous-analysis": (
            "A compatible previous analysis was selected "
            "for incremental analysis."
        ),
        "full-analysis": (
            "No compatible previous analysis was selected; "
            "a full analysis is required."
        ),
    }

    reuse_mode = row.get("reuse_mode") or "full-analysis"

    return {
        "id": str(row["id"]),
        "origin": row["origin"],
        "status": row["status"],
        "group_id": row["group_id"],
        "artifact_id": row["artifact_id"],
        "version": row["version"],
        "jar_sha256": row["jar_sha256"],
        "config_key": row["config_key"],
        "policy_sha256": row["policy_sha256"],
        "method_hash_schema": row["method_hash_schema"],
        "pa_archive_schema": row["pa_archive_schema"],
        "reuse_mode": reuse_mode,
        "reuse_of": (
            str(row["reuse_of"])
            if row["reuse_of"]
            else None
        ),
        "deduplicated": reuse_mode == "exact-result",
        "incremental": reuse_mode == "previous-analysis",
        "message": messages[reuse_mode],
        "error": row["error"],
        "created_at": (
            row["created_at"].isoformat()
            if row["created_at"]
            else None
        ),
        "started_at": (
            row["started_at"].isoformat()
            if row["started_at"]
            else None
        ),
        "finished_at": (
            row["finished_at"].isoformat()
            if row["finished_at"]
            else None
        ),
    }


def gav_from_pom(pom_bytes):
    """Pull groupId/artifactId/version out of a pom, falling back to the
    parent section where the project inherits them."""
    try:
        root = ET.fromstring(pom_bytes)
    except ET.ParseError:
        raise HTTPException(status_code=400, detail="pom is not well-formed XML")
    ns = root.tag.split("}")[0] + "}" if root.tag.startswith("{") else ""

    def find(parent, tag):
        el = parent.find(f"{ns}{tag}")
        return el.text.strip() if el is not None and el.text else None

    parent = root.find(f"{ns}parent")
    group = find(root, "groupId") or (parent is not None and find(parent, "groupId")) or None
    artifact = find(root, "artifactId")
    version = find(root, "version") or (parent is not None and find(parent, "version")) or None
    return group, artifact, version


