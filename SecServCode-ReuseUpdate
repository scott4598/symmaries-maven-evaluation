			this.deduplicated = deduplicated;
			this.jarSha256 = jarSha256;
			this.createdAt = createdAt;
			this.httpStatus = httpStatus;
			this.reuseMode = reuseMode;
			this.reuseOf = reuseOf;
			this.message = message;
		}
    }
