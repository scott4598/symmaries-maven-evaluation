def claim_job(conn):
    with conn.cursor() as cur:
        cur.execute(
            """WITH j AS (
                   SELECT id FROM scans WHERE status = 'queued'
                   ORDER BY created_at LIMIT 1
                   FOR UPDATE SKIP LOCKED
               )
               UPDATE scans s SET status = 'running', started_at = now()
               FROM j WHERE s.id = j.id
               RETURNING s.*"""
        )
        row = cur.fetchone()
    conn.commit()
    return row


def finish(conn, scan_id, result_path):
    with conn.cursor() as cur:
        cur.execute(
            """UPDATE scans SET status = 'done', result_path = %s, finished_at = now()
               WHERE id = %s""",
            (result_path, scan_id),
        )
    conn.commit()


def fail(conn, scan_id, message):
    with conn.cursor() as cur:
        cur.execute(
            """UPDATE scans SET status = 'failed', error = %s, finished_at = now()
               WHERE id = %s""",
            (message[:2000], scan_id),
        )
    conn.commit()


def ledger_insert(conn, sha256, config_key, policy_sha256, scan_id, result_path):
    with conn.cursor() as cur:
        cur.execute(
            """INSERT INTO ledger (jar_sha256, config_key, policy_sha256, scan_id, result_path)
               VALUES (%s, %s, %s, %s, %s) ON CONFLICT DO NOTHING""",
            (sha256, config_key, policy_sha256, scan_id, result_path),
        )
    conn.commit()


def get_scan(conn, scan_id):
    with conn.cursor() as cur:
        cur.execute("SELECT * FROM scans WHERE id = %s", (scan_id,))
        return cur.fetchone()

def download(repo, path, dest):
    r = session.get(f"{NEXUS_URL}/repository/{repo}/{path}", stream=True, timeout=120)
    if r.status_code == 404:
        return False
    r.raise_for_status()
    with open(dest, "wb") as f:
        shutil.copyfileobj(r.raw, f)
    return True


def upload(repo, path, file_path):
    with open(file_path, "rb") as f:
        r = session.put(f"{NEXUS_URL}/repository/{repo}/{path}", data=f, timeout=300)
    r.raise_for_status()


def maven_path(job, suffix):
    group = job["group_id"].replace(".", "/")
    a, v = job["artifact_id"], job["version"]
    return f"{group}/{a}/{v}/{a}-{v}{suffix}"


def fetch_input(job, work):
    """Download the jar (and pom when available). Returns the pom path or None."""
    jar = work / "input.jar"
    pom = work / "pom.xml"
    policy = work / "policy.xml"
    if job["origin"] == "nexus":
        if not download(STAGING_REPO, maven_path(job, ".jar"), jar):
            raise RuntimeError("jar disappeared from staging")
        has_pom = download(STAGING_REPO, maven_path(job, ".pom"), pom)
        has_policy = download(STAGING_REPO, maven_path(job, "-policy.xml"), policy)
    else:
        if not download(UPLOADS_REPO, f"{job['id']}/input.jar", jar):
            raise RuntimeError("uploaded jar not found in scan-uploads")
        has_pom = download(UPLOADS_REPO, f"{job['id']}/pom.xml", pom)
        has_policy = download(UPLOADS_REPO, f"{job['id']}/policy.xml", policy)
    return (pom if has_pom else None), (policy if has_policy else None)


def publish_to_trusted(job, jar, pom, policy, result_zip):
    """One multipart call to the components API. jar + pom + the result zip
    as a classifier artifact, all under the same coordinates."""
    fields = {
        "maven2.groupId": (None, job["group_id"]),
        "maven2.artifactId": (None, job["artifact_id"]),
        "maven2.version": (None, job["version"]),
        "maven2.generate-pom": (None, "false" if pom else "true"),
        "maven2.asset1": ("input.jar", open(jar, "rb")),
        "maven2.asset1.extension": (None, "jar"),
        "maven2.asset2": ("symmaries.zip", open(result_zip, "rb")),
        "maven2.asset2.extension": (None, "zip"),
        "maven2.asset2.classifier": (None, "symmaries"),
    }
    n = 3
    if pom:
        fields[f"maven2.asset{n}"] = ("pom.xml", open(pom, "rb"))
        fields[f"maven2.asset{n}.extension"] = (None, "pom")
        n += 1
    if policy:
        fields[f"maven2.asset{n}"] = ("policy.xml", open(policy, "rb"))
        fields[f"maven2.asset{n}.extension"] = (None, "xml")
        fields[f"maven2.asset{n}.classifier"] = (None, "policy")
        n += 1
    r = session.post(
        f"{NEXUS_URL}/service/rest/v1/components",
        params={"repository": TRUSTED_REPO},
        files=fields,
        timeout=300,
    )
    r.raise_for_status()

def resolve_dependencies(pom, work):
    """Use Maven to copy the pom's dependencies into work/deps. Resolution
    goes through the in-cluster Nexus group. Failure is not fatal: the scan
    still runs, just with less type information."""
    deps_dir = work / "deps"
    deps_dir.mkdir(exist_ok=True)
    cmd = [
        "mvn", "-q", "-B", "-s", MAVEN_SETTINGS, "-f", str(pom),
        "dependency:copy-dependencies",
        f"-DoutputDirectory={deps_dir}",
        "-DincludeScope=runtime",
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=DEPS_TIMEOUT_SECONDS)
        if proc.returncode != 0:
            log.warning("dependency resolution failed:\n%s", proc.stdout[-2000:])
    except subprocess.TimeoutExpired:
        log.warning("dependency resolution timed out after %ss", DEPS_TIMEOUT_SECONDS)
    jars = sorted(glob.glob(str(deps_dir / "*.jar")))
    return ":".join(jars)


def declare_dummy_source_fields(out):
    """This is a work-around for a bug in JSymCompiler. The frontend models declared 
    field sources as reads of static fields on a generated dummyClass, but never declares those fields in
    types.classes so the engine then rejects every method containing such a
    read. Collect the dummy field names actually used and declare them."""
    fields = set()
    for meth in (out / "Meth").glob("*.meth"):
        for name in re.findall(r"dummyClass\.(highSource\w+)\b(?!\s*\()", meth.read_text()):
            fields.add(name)
    if not fields:
        return
    decls = "".join(f"static int  {name}; " for name in sorted(fields))
    types = out / "types.classes"
    content = types.read_text().replace(
        "dummyClass  <: java.lang.Object{}",
        "dummyClass  <: java.lang.Object{" + decls + "}",
    )
    types.write_text(content)
    log.info("declared dummy source fields: %s", ", ".join(sorted(fields)))

PA_FILES = (
    "methodHashmap.json",
    "combined.meth",
    "results.secsums",
)

def extract_and_validate_pa_files(
    zip_path,
    work,
    job,
    source_scan,
):
    pa_dir = work / "pa"
    pa_dir.mkdir(exist_ok=True)

    with zipfile.ZipFile(zip_path) as zip_file:
        by_name = {
            Path(name).name: name
            for name in zip_file.namelist()
        }

        info_member = by_name.get("scan-info.json")

        if info_member is None:
            raise RuntimeError(
                "previous-analysis archive has no scan-info.json"
            )

        with zip_file.open(info_member) as stream:
            try:
                scan_info = json.load(stream)
            except json.JSONDecodeError as exception:
                raise RuntimeError(
                    "previous-analysis scan-info.json is invalid"
                ) from exception

        expected = {
            "config_key": job["config_key"],
            "policy_sha256": job.get(
                "policy_sha256",
                "",
            ),
            "method_hash_schema": METHOD_HASH_SCHEMA,
            "pa_archive_schema": PA_ARCHIVE_SCHEMA,
        }

        for field, expected_value in expected.items():
            actual_value = scan_info.get(field)

            if actual_value != expected_value:
                raise RuntimeError(
                    "previous-analysis archive is incompatible: "
                    f"{field} expected {expected_value!r}, "
                    f"found {actual_value!r}"
                )

        if (
            source_scan["group_id"] != job["group_id"]
            or source_scan["artifact_id"]
            != job["artifact_id"]
        ):
            raise RuntimeError(
                "previous-analysis scan belongs to a different GA"
            )

        extracted_paths = []

        for filename in PA_FILES:
            member = by_name.get(filename)

            if member is None:
                raise RuntimeError(
                    "previous-analysis archive is missing "
                    f"{filename}"
                )

            target = pa_dir / filename

            with zip_file.open(member) as source:
                with open(target, "wb") as destination:
                    shutil.copyfileobj(
                        source,
                        destination,
                    )

            if target.stat().st_size == 0:
                raise RuntimeError(
                    "previous-analysis archive contains an "
                    f"empty {filename}"
                )

            extracted_paths.append(target)

    return extracted_paths


def run_analyzer(work, classpath, policy, pa_files=None):
    out = work / "out"
    out.mkdir(exist_ok=True)
    (out / "logs").mkdir(exist_ok=True)

    if policy is not None:
        ss = policy
        policy_source = "artifact"
    else:
        default = Path(POLICY_DIR) / "sources-and-sinks.xml"
        if default.exists():
            ss = default
            policy_source = "central-default"
        else:
            raise RuntimeError(
                "no sources/sinks policy supplied with the artifact; deploy a "
                "'-policy.xml' sidecar next to the jar or upload one via the API "
                )
    log.info("policy source: %s (%s)", policy_source, ss)


    cmd = ["java", "-jar", JSYM_JAR, str(work / "input.jar"), "-o", str(out),
           "-ss", str(ss)]
    for stub in sorted(Path(POLICY_DIR).glob("*.secstubs")):
        cmd += ["-tf", str(stub)]
    if classpath:
        cmd += ["-cp", classpath]
    if pa_files:
        cmd += ["-pa", str(pa_files[0]), str(pa_files[1]), str(pa_files[2])]
    cmd += JSYM_EXTRA_ARGS

    log.info("frontend: %s", " ".join(cmd))
    proc = subprocess.run(cmd, capture_output=True, text=True,
                          timeout=SCAN_TIMEOUT_SECONDS, cwd=str(out))
    (out / "logs" / "frontend-stdout.log").write_text(proc.stdout)
    (out / "logs" / "frontend-stderr.log").write_text(proc.stderr)
    if not (out / "Meth" / "all.meth_files").exists():
        tail = (proc.stdout + "\n" + proc.stderr)[-1500:]
        raise RuntimeError(f"frontend produced no method files (exit {proc.returncode}): {tail}")

    declare_dummy_source_fields(out) # Need to fix this in JSymCompiler, but this is a workaround for now.

    env = dict(os.environ, OCAMLRUNPARAM="h=1G") # Invoking syrs without +runSyrs now.
    types_cmd = ["syrs", "-ll", "w", "-tf", SYRS_TFLAGS,
                 str(out / "types.classes"),
                 "-o", str(out / "types.classes_bin"),
                 "-o", str(out / "types.class_stats")]
    (out / "Syrs").mkdir(exist_ok=True)
    analyze_cmd = ["syrs", "-ll", "w", "--oflags", "+scfg", "-tf", SYRS_TFLAGS,
                   str(out / "types.classes_bin"),
                   str(out / "Meth" / "all.secstubs"),
                   str(out / "Meth" / "all.meth_files"),
                   "-rf", "-dr", "-rf", "cuddmem=2GiB",
                   "-pf", f"timeout={SYRS_TIMEOUT}",
                   "--methskip-cond", "300", "--safe-walk",
                   "-o", str(out / "results.secsums"),
                   "-o", str(out / "results.meth_stats")]
    for name, cmd in (("types", types_cmd), ("analysis", analyze_cmd)):
        log.info("engine %s pass", name)
        proc = subprocess.run(cmd, capture_output=True, text=True,
                              timeout=SCAN_TIMEOUT_SECONDS, cwd=str(out), env=env)
        (out / "logs" / f"engine-{name}.log").write_text(proc.stdout + "\n" + proc.stderr)
        if proc.returncode != 0:
            tail = (proc.stdout + "\n" + proc.stderr)[-1500:]
            raise RuntimeError(f"engine {name} pass failed (exit {proc.returncode}): {tail}")

    if not glob.glob(str(out / "*.secsums")):
        raise RuntimeError("engine completed but produced no .secsums output")
    return out, policy_source


def make_zip(job, out_dir, work, config_key, started_at, policy_source):
    info = {
        "scan_id": str(job["id"]),
        "group_id": job["group_id"],
        "artifact_id": job["artifact_id"],
        "version": job["version"],
        "jar_sha256": job["jar_sha256"],
        "config_key": config_key,
        "policy_sha256": job.get(
            "policy_sha256",
            "",
        ),
        "method_hash_schema": METHOD_HASH_SCHEMA,
        "pa_archive_schema": PA_ARCHIVE_SCHEMA,
        "reuse_mode": job.get(
            "reuse_mode",
            "full-analysis",
        ),
        "reuse_of": (
            str(job["reuse_of"])
            if job.get("reuse_of")
            else None
        ),
        "policy_source": policy_source,
        "started_at": started_at.isoformat(),
        "finished_at": datetime.datetime.now(
            datetime.timezone.utc
        ).isoformat(),
    }
    (out_dir / "scan-info.json").write_text(json.dumps(info, indent=2))

    zip_path = work / "symmaries.zip"
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for f in sorted(out_dir.rglob("*")):
            if f.is_file():
                zf.write(f, f.relative_to(out_dir))
    return zip_path

def process(conn, job):
    started = datetime.datetime.now(
        datetime.timezone.utc
    )

    with tempfile.TemporaryDirectory(
        prefix="scan-"
    ) as temporary_directory:
        work = Path(temporary_directory)

        result_path = (
            f"{job['id']}/symmaries.zip"
        )

        pom, policy = fetch_input(job, work)

        reuse_mode = job.get(
            "reuse_mode",
            "full-analysis",
        )

        if reuse_mode == "exact-result":
            raise RuntimeError(
                "exact-result scans must not be queued"
            )

        if reuse_mode == "previous-analysis":
            if not job["reuse_of"]:
                raise RuntimeError(
                    "previous-analysis scan has no reuse_of"
                )

            source_scan = get_scan(
                conn,
                job["reuse_of"],
            )

            if (
                not source_scan
                or source_scan["status"] != "done"
                or not source_scan["result_path"]
            ):
                raise RuntimeError(
                    "previous scan is missing, unfinished, "
                    "or has no results"
                )

            previous_zip = work / "previous-analysis.zip"

            downloaded = download(
                REPORTS_REPO,
                source_scan["result_path"],
                previous_zip,
            )

            if not downloaded:
                raise RuntimeError(
                    "previous-analysis result ZIP is missing"
                )

            try:
                pa_files = extract_and_validate_pa_files(
                    previous_zip,
                    work,
                    job,
                    source_scan,
                )

                log.info(
                    "scan %s: running JSymCompiler with -pa "
                    "from scan %s",
                    job["id"],
                    source_scan["id"],
                )

                zip_path = run_incremental_analysis_for_job(
                    job,
                    work,
                    pom,
                    policy,
                    pa_files,
                    started,
                )

            except Exception:
                if PA_FAILURE_MODE == "strict":
                    raise

                log.exception(
                    "scan %s: previous-analysis reuse failed; "
                    "falling back to full analysis",
                    job["id"],
                )

                # Remove any partial output produced by the failed -pa run.
                shutil.rmtree(
                    work / "out",
                    ignore_errors=True,
                )

                # Persist the actual execution mode before starting the fallback.
                set_reuse_mode(
                    conn,
                    job["id"],
                    "full-analysis",
                    None,
                )

                # Keep the in-memory job consistent with the database row.
                job["reuse_mode"] = "full-analysis"
                job["reuse_of"] = None

                zip_path = run_full_analysis_for_job(
                    job,
                    work,
                    pom,
                    policy,
                    started,
                )

        elif reuse_mode == "full-analysis":
            zip_path = run_full_analysis_for_job(
                job,
                work,
                pom,
                policy,
                started,
            )

        else:
            raise RuntimeError(
                f"unknown reuse_mode: {reuse_mode}"
            )

        upload(
            REPORTS_REPO,
            result_path,
            zip_path,
        )

        if job["origin"] == "nexus":
            publish_to_trusted(
                job,
                work / "input.jar",
                pom,
                policy,
                zip_path,
            )

        ledger_insert(
            conn,
            job["jar_sha256"],
            job["config_key"],
            job.get("policy_sha256", ""),
            job["id"],
            result_path,
        )

        finish(
            conn,
            job["id"],
            result_path,
        )

        log.info(
            "scan %s done using %s",
            job["id"],
            job.get(
                "reuse_mode",
                "full-analysis",
            ),
        )


def main():
    log.info("worker starting; analyzer jar: %s", JSYM_JAR)
    while True:
        try:
            conn = psycopg2.connect(DATABASE_URL, cursor_factory=psycopg2.extras.RealDictCursor)
        except psycopg2.OperationalError as e:
            log.warning("database not reachable (%s); retrying", e)
            time.sleep(IDLE_SLEEP_SECONDS)
            continue
        try:
            while True:
                job = claim_job(conn)
                if job is None:
                    time.sleep(IDLE_SLEEP_SECONDS)
                    continue
                log.info("claimed scan %s (%s:%s:%s)", job["id"],
                         job["group_id"], job["artifact_id"], job["version"])
                try:
                    process(conn, job)
                except Exception as e:
                    log.exception("scan %s failed", job["id"])
                    conn.rollback()
                    fail(conn, job["id"], str(e))
        except psycopg2.Error:
            log.exception("database error; reconnecting")
            time.sleep(IDLE_SLEEP_SECONDS)
        finally:
            conn.close()
            
def run_full_analysis_for_job(
    job,
    work,
    pom,
    policy,
    started,
):
    classpath = (
        resolve_dependencies(pom, work)
        if pom
        else ""
    )

    out_dir, policy_source = run_analyzer(
        work,
        classpath,
        policy,
    )

    zip_path = make_zip(
        job,
        out_dir,
        work,
        job["config_key"],
        started,
        policy_source,
    )
    return zip_path
    
def run_incremental_analysis_for_job(
    job,
    work,
    pom,
    policy,
    pa_files,
    started,
):
    classpath = (
        resolve_dependencies(pom, work)
        if pom
        else ""
    )

    out_dir, policy_source = run_analyzer(
        work,
        classpath,
        policy,
        pa_files=pa_files,
    )

    zip_path = make_zip(
        job,
        out_dir,
        work,
        job["config_key"],
        started,
        policy_source,
    )

    return zip_path
    
def set_reuse_mode(
    conn,
    scan_id,
    reuse_mode,
    reuse_of=None,
):
    with conn.cursor() as cur:
        cur.execute(
            """
            UPDATE scans
            SET reuse_mode = %s,
                reuse_of = %s
            WHERE id = %s
            """,
            (
                reuse_mode,
                reuse_of,
                scan_id,
            ),
        )

    conn.commit()


if __name__ == "__main__":
    main()
    
    
    
