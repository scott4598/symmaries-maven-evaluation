<?xml version="1.0" encoding="UTF-8"?>

<settings
    xmlns="http://maven.apache.org/SETTINGS/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://maven.apache.org/SETTINGS/1.2.0
        https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <interactiveMode>false</interactiveMode>

  <mirrors>
    <mirror>
      <id>symproto-public</id>
      <name>Symmaries public repository group</name>
      <url>http://localhost:8081/repository/public/</url>
      <mirrorOf>*</mirrorOf>
      <blocked>false</blocked>
    </mirror>
  </mirrors>

  <servers>
    <server>
      <id>symproto-staging</id>
      <username>${env.SYMPROTO_NEXUS_USERNAME}</username>
      <password>${env.SYMPROTO_NEXUS_PASSWORD}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>symmaries-pilot-host</id>

      <properties>
        <symmaries.apiUrl>http://localhost:8000</symmaries.apiUrl>
        <symmaries.timeoutSeconds>1800</symmaries.timeoutSeconds>
        <symmaries.pollIntervalSeconds>5</symmaries.pollIntervalSeconds>
      </properties>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>symmaries-pilot-host</activeProfile>
  </activeProfiles>
</settings>
