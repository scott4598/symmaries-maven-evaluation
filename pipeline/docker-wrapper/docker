#!/usr/bin/env bash
set -euo pipefail

docker_bin="/usr/bin/docker"

if [[ ! -x "$docker_bin" ]]; then
    echo "Docker executable not found: $docker_bin" >&2
    exit 127
fi

if [[ "${1:-}" != "run" ]]; then
    exec "$docker_bin" "$@"
fi

arguments=("${@:2}")
injected=("run")

if [[ " ${arguments[*]} " != *" host.docker.internal:host-gateway "* ]]; then
    injected+=(
        "--add-host"
        "host.docker.internal:host-gateway"
    )
fi

if [[ -n "${SYMMARIES_API_KEY:-}" ]]; then
    injected+=(
        "--env"
        "SYMMARIES_API_KEY"
    )
fi

if [[ -n "${SYMPROTO_NEXUS_USERNAME:-}" ]]; then
    injected+=(
        "--env"
        "SYMPROTO_NEXUS_USERNAME"
    )
fi

if [[ -n "${SYMPROTO_NEXUS_PASSWORD:-}" ]]; then
    injected+=(
        "--env"
        "SYMPROTO_NEXUS_PASSWORD"
    )
fi

for argument in "${arguments[@]}"; do
    case "$argument" in
        -it|-ti|-i|-t|--interactive|--tty)
            ;;
        *)
            injected+=("$argument")
            ;;
    esac
done

exec "$docker_bin" "${injected[@]}"
